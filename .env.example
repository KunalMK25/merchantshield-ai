# MerchantShield AI — environment configuration
#
# Nothing here is required. Copy to .env (docker compose reads it) or export the variables
# before starting the API. Unset means the default shown.

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------

# Retrain automatically every N hours inside the API process (0 or unset = off; use cron instead:
#   0 2 * * *  cd /path/to/merchantshield-ai && .venv/bin/python -m ml.retrain.job).
# Needs a single worker. docker-compose.yml defaults this to 24.
# MS_RETRAIN_INTERVAL_HOURS=24

# Shared secret required (header X-Analyst-Token) for analyst actions: place hold, dismiss,
# release, close. Unset = demo mode, anyone who can reach the API can act. Set it before exposing
# the app anywhere. Reading the alert queue never needs it.
# MS_ANALYST_TOKEN=change-me

# Where the model registry and the generated data / logs / alert queue live.
# Defaults: ml/registry_store and ml/data_store inside the project.
# MS_REGISTRY_DIR=/path/to/registry
# MS_DATA_STORE_DIR=/path/to/data_store

# ---------------------------------------------------------------------------
# Frontend (frontend/.env, optional)
# ---------------------------------------------------------------------------
# Base URL the dashboard uses for API calls. Only needed when the Vite dev server (`npm run dev`)
# runs separately from the backend on another origin; the dev server already proxies the API paths
# to http://localhost:8000. When the built frontend is served by FastAPI itself, leave it unset.
#
# VITE_API_BASE_URL=http://127.0.0.1:8000
